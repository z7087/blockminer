+++ b/src/main/java/me/z7087/blockminer/util/constants/Directions.java
@@ -0,0 +1,57 @@
+package me.z7087.blockminer.util.constants;
+
+import net.minecraft.util.math.Direction;
+
+/**
+ * 方向常量。
+ *
+ * <p>它们原本放在 {@link me.z7087.blockminer.util.finder.BlockFinder} 里，但 {@link PositionsInSteps}
+ * 的静态初始化要用到 {@code Directions.DIRECTIONS}，于是形成了这样一条类初始化环：
+ *
+ * <pre>
+ * PositionsInSteps.S4.&lt;clinit&gt;
+ *   -> S3 -> S2 -> S1
+ *   -> BlockFinder.&lt;clinit&gt;                        （因为要读 BlockFinder.DIRECTIONS）
+ *   -> findAllPossibleStructures -> new BlockBreakStructure(...)
+ *   -> DeduplicationInS4.&lt;clinit&gt;
+ *   -> new ObjectOpenHashSet&lt;&gt;(S4.posList)          （此时 S4.posList 还是 null！）
+ * </pre>
+ *
+ * <p>结果就是：如果程序第一次碰到的类是 {@code PositionsInSteps.S1/S2/S3/S4}（而不是
+ * {@code BlockFinder} 或 {@code BlockFinder.AllStructures}），就会在
+ * {@code DeduplicationInS4} 里吃到 {@code NullPointerException}。
+ * 真实游戏里恰好是 {@code BlockMinerMod#loadClassesBackground} 先碰 {@code BlockFinder}，
+ * 所以一直没暴露。
+ *
+ * <p>把这些常量独立出来之后，{@code PositionsInSteps} 的初始化不再触碰 {@code BlockFinder}，
+ * 环就断了。
+ */
+public final class Directions {
+    private Directions() {}
+
+    public static final Direction[] DIRECTIONS = Direction.values();
+
+    /** {@code DIRECTIONS_WITHOUT[face.ordinal()]} = 除 face 之外的所有方向。 */
+    public static final Direction[][] DIRECTIONS_WITHOUT;
+
+    static {
+        final Direction[] directions = DIRECTIONS;
+        final int count = directions.length;
+        DIRECTIONS_WITHOUT = new Direction[count][count - 1];
+        for (int i = 0; i < count; ++i) {
+            final Direction direction = directions[i];
+            for (int j = 0, k = 0; j < count; ++j) {
+                final Direction anotherDirection = directions[j];
+                if (anotherDirection != direction) {
+                    DIRECTIONS_WITHOUT[i][k++] = anotherDirection;
+                }
+            }
+        }
+    }
+
+    /** 除 UP 之外的所有方向。 */
+    public static final Direction[] DIRECTIONS_WITHOUT_UP = DIRECTIONS_WITHOUT[Direction.UP.ordinal()];
+
+    /** 除 DOWN 之外的所有方向。 */
+    public static final Direction[] DIRECTIONS_WITHOUT_DOWN = DIRECTIONS_WITHOUT[Direction.DOWN.ordinal()];
+}
