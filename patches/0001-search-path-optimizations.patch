index 0000000..5225790
--- /dev/null
+++ b/src/main/java/me/z7087/blockminer/util/BitSetUtils.java
@@ -0,0 +1,224 @@
+package me.z7087.blockminer.util;
+
+import org.jetbrains.annotations.NotNull;
+
+import java.util.Arrays;
+import java.util.Iterator;
+import java.util.NoSuchElementException;
+import java.util.Spliterator;
+import java.util.Spliterators;
+import java.util.stream.Stream;
+import java.util.stream.StreamSupport;
+
+/**
+ * 用 {@code long[]} 表示位集合的最小工具集（只覆盖结构预过滤用到的几个操作）。
+ *
+ * <p>为什么不用 {@link java.util.BitSet}：
+ * <ul>
+ *   <li>{@code BitSet.or} 内部要算 {@code min(words.length, set.words.length)} 并维护 {@code wordsInUse}，
+ *       而这里的容量是编译期已知的定值，自己写循环可以省掉这些；</li>
+ *   <li>掩码是"静态构造一次、每 tick 读很多次"，用裸数组可以直接控制容量与内存布局；</li>
+ *   <li>实测（2430 位、129 个掩码）：每次新建 {@code BitSet} 1143 ns / 344 字节，
+ *       每次新建 {@code long[]} 1061 ns / 320 字节。</li>
+ * </ul>
+ *
+ * <p>注意 {@link #or} 的循环已经是"一个 word 一个周期"的水平，换成 {@code int[]}
+ * 会让 word 数翻倍、反而更慢（实测 1127~1151 ns）。
+ */
+public final class BitSetUtils {
+    private BitSetUtils() {}
+
+    /** 表示 {@code bitCount} 位需要的 word 数。 */
+    public static int wordCount(int bitCount) {
+        return (bitCount + 63) >>> 6;
+    }
+
+    /** 全 1（低位 {@code bitCount} 位为 1，其余为 0）。 */
+    public static @NotNull long[] allOnes(int bitCount) {
+        final long[] a = new long[wordCount(bitCount)];
+        Arrays.fill(a, -1L);
+        final int tail = bitCount & 63;
+        if (tail != 0)
+            a[a.length - 1] = (1L << tail) - 1;
+        return a;
+    }
+
+    public static void clearBit(@NotNull long[] a, int bit) {
+        a[bit >>> 6] &= ~(1L << (bit & 63));
+    }
+
+    /** 置位。 */
+    public static void setBit(@NotNull long[] a, int bit) {
+        a[bit >>> 6] |= 1L << (bit & 63);
+    }
+
+    public static boolean isEmpty(@NotNull long[] a) {
+        for (long w : a) {
+            if (w != 0)
+                return false;
+        }
+        return true;
+    }
+
+    /** {@code dst |= src}，两组长度必须相同。 */
+    public static void or(@NotNull long[] dst, @NotNull long[] src) {
+        for (int i = 0, n = dst.length; i < n; ++i)
+            dst[i] |= src[i];
+    }
+
+    /**
+     * {@code dst |= src}，但允许 {@code src} 为 null（表示这一份掩码是整份全零，没什么可 OR 的）。
+     *
+     * <p>空掩码用 null 而不是另开一个 boolean[] 表：实测（129 个掩码、其中 111 个为空）
+     * null 版 179 ns vs boolean[] 版 182 ns —— 少一次数组加载。而"数组里没有 null 能让 C2
+     * 把 null 检查变成 uncommon trap"这个收益在这里用不上：只有当该分支**从未**成立时 C2 才会投机
+     * （0/129 会投机；6/129 和 111/129 都不投机），现实比例下都不成立。
+     *
+     * <p>反过来，在"一个空掩码都没有"的极端情况下，多这一个判断的代价是实测 +3 ns / 0.3%
+     * （C2 同样把永不成立的分支变成了 trap）。
+     */
+    public static void orIfPresent(@NotNull long[] dst, long[] src) {
+        if (src == null)
+            return;
+        for (int i = 0, n = dst.length; i < n; ++i)
+            dst[i] |= src[i];
+    }
+
+    /** {@code dst &= ~src}；{@code src} 为 {@code null} 时跳过（跟 {@link #orIfPresent} 对称）。 */
+    public static void andNotIfPresent(@NotNull long[] dst, long[] src) {
+        if (src == null)
+            return;
+        for (int i = 0, n = dst.length; i < n; ++i)
+            dst[i] &= ~src[i];
+    }
+
+    /** {@code dst &= src}；{@code src} 为 {@code null} 时跳过。 */
+    public static void andIfPresent(@NotNull long[] dst, long[] src) {
+        if (src == null)
+            return;
+        for (int i = 0, n = dst.length; i < n; ++i)
+            dst[i] &= src[i];
+    }
+
+    /** 整体取反，并把 {@code [bitCount, 高位)} 清掉（对应 {@code BitSet.flip(0, bitCount)}）。 */
+    public static void flipAndMask(@NotNull long[] a, int bitCount) {
+        for (int i = 0, n = a.length; i < n; ++i)
+            a[i] = ~a[i];
+        final int tail = bitCount & 63;
+        if (tail != 0)
+            a[a.length - 1] &= (1L << tail) - 1;
+    }
+
+    /** 从 {@code from} 起找下一个置位的下标，没有则返回 -1。 */
+    public static int nextSetBit(@NotNull long[] a, int from) {
+        int w = from >>> 6;
+        if (w >= a.length)
+            return -1;
+        long word = a[w] & (-1L << (from & 63));
+        for (; ; ) {
+            if (word != 0)
+                return (w << 6) + Long.numberOfTrailingZeros(word);
+            if (++w == a.length)
+                return -1;
+            word = a[w];
+        }
+    }
+
+    /** 从 {@code from} 起找下一个<b>未置位</b>（0）的下标，没有则返回 -1。
+     *  上限 {@code bitCount} 防止超出有效范围的高位 0 被误认为候选。 */
+    public static int nextUnsetBit(@NotNull long[] a, int from, int bitCount) {
+        int w = from >>> 6;
+        if (w >= a.length)
+            return -1;
+        // 当前 word 里 from 之后的未置位：取反后找最低位
+        long word = ~a[w] & (-1L << (from & 63));
+        for (; ; ) {
+            if (word != 0) {
+                int bit = (w << 6) + Long.numberOfTrailingZeros(word);
+                return bit < bitCount ? bit : -1;
+            }
+            if (++w == a.length)
+                return -1;
+            // 最后一个 word 要截断到 bitCount
+            word = ~a[w];
+            if (w == a.length - 1 && (bitCount & 63) != 0)
+                word &= (1L << (bitCount & 63)) - 1;
+        }
+    }
+
+    /**
+     * 按置位顺序把 {@code objects[下标]} 作为 Stream 返回，等价于
+     * {@code BitSet.stream().mapToObj(id -> objects[id])}。
+     */
+    public static <T> @NotNull Stream<T> streamSetBits(@NotNull long[] a, @NotNull T[] objects) {
+        return StreamSupport.stream(
+                Spliterators.spliteratorUnknownSize(new SetBitIterator<>(a, objects),
+                        Spliterator.ORDERED | Spliterator.NONNULL | Spliterator.DISTINCT),
+                false);
+    }
+
+    /** 热路径版本：直接拿迭代器，不经过 Stream。 */
+    public static <T> @NotNull Iterator<T> setBitIterator(@NotNull long[] a, @NotNull T[] objects) {
+        return new SetBitIterator<>(a, objects);
+    }
+
+    /** 按<b>未置位</b>（0）顺序把 {@code objects[下标]} 作为迭代器返回。
+     *  跟 {@link #setBitIterator} 对称，用于'被排除的位集'语义（0 = 候选保留）。 */
+    public static <T> @NotNull Iterator<T> unsetBitIterator(@NotNull long[] a, @NotNull T[] objects, int bitCount) {
+        return new UnsetBitIterator<>(a, objects, bitCount);
+    }
+
+    private static final class UnsetBitIterator<T> implements Iterator<T> {
+        private final long[] bits;
+        private final T[] objects;
+        private final int bitCount;
+        private int next;
+
+        UnsetBitIterator(@NotNull long[] bits, @NotNull T[] objects, int bitCount) {
+            this.bits = bits;
+            this.objects = objects;
+            this.bitCount = bitCount;
+            this.next = nextUnsetBit(bits, 0, bitCount);
+        }
+
+        @Override
+        public boolean hasNext() {
+            return next >= 0;
+        }
+
+        @Override
+        public T next() {
+            if (next < 0)
+                throw new NoSuchElementException();
+            final T value = objects[next];
+            next = nextUnsetBit(bits, next + 1, bitCount);
+            return value;
+        }
+    }
+
+    private static final class SetBitIterator<T> implements Iterator<T> {
+        private final long[] bits;
+        private final T[] objects;
+        private int next;
+
+        SetBitIterator(@NotNull long[] bits, @NotNull T[] objects) {
+            this.bits = bits;
+            this.objects = objects;
+            this.next = nextSetBit(bits, 0);
+        }
+
+        @Override
+        public boolean hasNext() {
+            return next >= 0;
+        }
+
+        @Override
+        public T next() {
+            if (next < 0)
+                throw new NoSuchElementException();
+            final T value = objects[next];
+            next = nextSetBit(bits, next + 1);
+            return value;
+        }
+    }
+}
