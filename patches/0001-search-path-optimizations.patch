+package me.z7087.blockminer.util.data;
+
+import me.z7087.blockminer.util.BlockUtils;
+import me.z7087.blockminer.util.finder.BlockFinder;
+import net.minecraft.block.BlockState;
+import net.minecraft.block.Blocks;
+import net.minecraft.block.ShapeContext;
+import net.minecraft.util.math.BlockPos;
+import net.minecraft.util.math.Direction;
+import net.minecraft.world.World;
+import org.jetbrains.annotations.NotNull;
+import me.z7087.blockminer.util.BitSetUtils;
+
+/**
+ * 一次"结构搜索"的世界查询缓存。
+ *
+ * <p>背景：{@code Task.start()} 每 tick 都会调一次 {@code SearchMode.findPossibleStructures}，
+ * 返回的 Stream 会按偏好顺序逐个候选调用 {@link BlockBreakStructure#testBeforePlace}，
+ * 直到第一个通过全部检查的候选出现为止。当目标方块当前无解（地形不对、玩家还没到位）时，
+ * Stream 会被完整消费，也就是 <b>2430 个候选结构各做一遍完整的 testBeforePlace</b>。
+ *
+ * <p>而 testBeforePlace 里的世界查询高度重复：
+ * <ul>
+ *   <li>「活塞位置 + 活塞朝向」的合法性（含 2 次 {@code World#canPlace} 与
+ *       {@link BlockFinder#isPistonPlaceSafe} 里的 11 次 {@code isEmittingRedstonePower}）
+ *       只由 (pistonOffset, pistonFace) 决定，而全部 2430 个结构只对应 <b>30 种</b>组合；</li>
+ *   <li>{@code powerBlockPos} 的可放置性只由位置决定，2430 个结构只对应 62 个不同位置；</li>
+ *   <li>{@code getBlockState} / {@code canPlace} / {@code getReceivedStrongRedstonePower}
+ *       都是"位置 → 结果"的纯函数，在一次搜索内世界不会被修改。</li>
+ * </ul>
+ *
+ * <p>缓存的生命周期严格等于一次搜索（由 {@code findPossibleFullStructuresInCache} 创建、
+ * 随 Stream 一起被丢弃），期间不会有方块变更，因此缓存命中与真实查询结果必然相同。
+ *
+ * <h2>寻址：偏移盒子 + 每缓存稠密下标</h2>
+ *
+ * <p>这个上下文换掉的是"世界查询"，加上的是"查找"。省下的是贵的
+ * （{@code canPlace} 会扫实体碰撞、{@code isEmittingRedstonePower} 会算红石强度），
+ * 加上的是便宜的 —— 但一次搜索要对 2430 个候选各做约 8 次查找，所以查找本身必须接近免费。
+ *
+ * <p>第一层是<b>偏移盒子</b>：{@code testBeforePlace} 访问的每个位置都是
+ * {@code targetPos + offset}，而 offset 的三个分量都很小 —— 从结构集合里枚举出来是
+ * dx∈[-4,4]、dy∈[-5,5]、dz∈[-4,4]，于是
+ * {@code (dx,dy,dz) -> ((dx+4)*11 + (dy+5))*9 + (dz+4)} 是一个纯算术的双射，把查找变成一次数组访问。
+ *
+ * <p>第二层是<b>稠密下标</b>：盒子有 891 个槽，但每个缓存实际只会被问到其中一小部分
+ * （从 {@code BlockFinder.AllStructures} 推导），
+ * 于是六个缓存各自再经一张 {@code byte[891]} 表映射到 {@code 0..n-1}。
+ * 每张表 891 字节、<b>在整个进程里只分配一次</b>，而每个上下文省下的是
+ * <b>11,679 → 1,444 字节</b>的分配（每次搜索都要新建一个上下文，
+ * 于是那 10 KB 的归零与 GC 扫描是每次搜索都要付的）。
+ *
+ * <p>落在这张表之外的 offset（理论上不会出现）不缓存，直接问世界 —— 只是慢一点，语义不变。
+ *
+ * <p>注意：这是"少问世界几次"，不是"少搜几次" —— 搜索本身仍然是每 tick 全量做的。
+ */
+public final class StructureSearchContext {
+    // 静态枚举出的 offset 范围（见类注释）。超出就退回"不缓存"。
+    private static final int RANGE_X = 4;
+    private static final int RANGE_Y = 5;
+    private static final int RANGE_Z = 4;
+    private static final int DIM_X = 2 * RANGE_X + 1;
+    private static final int DIM_Y = 2 * RANGE_Y + 1;
+    private static final int DIM_Z = 2 * RANGE_Z + 1;
+    private static final int SLOTS = DIM_X * DIM_Y * DIM_Z;
+    /** 超出盒子时的返回值，表示"不缓存，直接问世界"。 */
+    private static final int OUT_OF_BOX = -1;
+
+    private static final byte UNKNOWN = 0;
+    private static final byte YES = 1;
+    private static final byte NO = 2;
+
+    private static final int DIRECTION_COUNT = Direction.values().length;
+    private static final int PISTON_KEY_COUNT = DIRECTION_COUNT * DIRECTION_COUNT;
+
+    private static final BlockState STONE = Blocks.STONE.getDefaultState();
+
+    private final @NotNull World world;
+    private final @NotNull BlockPos targetPos;
+    private final boolean hasDependBlock;
+
+    /** 下列六个数组都按偏移盒子下标索引。 */
+    private final BlockState[] stateCache;
+    private final byte[] canPlaceCache;
+    private final byte[] powerBlockPosCache;
+    private final byte[] strongPowerCache;
+    private final short[] emittingCache;
+
+    /**
+     * 整个偏移盒子是否都在可建范围内。世界可建区域是一个长方体
+     * （{@code isOutOfHeightLimit} 只看 Y，{@code isValidHorizontally} 是 ±30000000 的方框），
+     * 所以"包围盒的两个对角点都在范围内"就等价于"盒子里的每个位置都在范围内" ——
+     * 于是常见情况下一次搜索里近两千次判断可以塌缩成构造时的两次（见 {@link #isInBuildLimit}）。
+     */
+    private final boolean boxInBuildLimit;
+    /** offset -> isInBuildLimit 的结果（只在盒子没有整体落在范围内时才用得上） */
+    private final byte[] inBuildLimitCache = new byte[SLOTS];
+
+    /** key = pistonOffset.ordinal() * 6 + pistonFace.ordinal()，只有 30 种组合 */
+    private final byte[] pistonPlacementCache = new byte[PISTON_KEY_COUNT];
+    private final BlockPos[] pistonPosCache = new BlockPos[PISTON_KEY_COUNT];
+    private final BlockPos[] pistonHeadPosCache = new BlockPos[PISTON_KEY_COUNT];
+
+    public StructureSearchContext(@NotNull World world, @NotNull BlockPos targetPos, boolean hasDependBlock) {
+        this.world = world;
+        this.targetPos = targetPos;
+        this.hasDependBlock = hasDependBlock;
+
+        // 两个对角点都在可建范围内 ⟹ 整个盒子都在（可建区域是长方体）
+        this.boxInBuildLimit = world.isInBuildLimit(new BlockPos(
+                targetPos.getX() - RANGE_X, targetPos.getY() - RANGE_Y, targetPos.getZ() - RANGE_Z))
+                && world.isInBuildLimit(new BlockPos(
+                targetPos.getX() + RANGE_X, targetPos.getY() + RANGE_Y, targetPos.getZ() + RANGE_Z));
+        this.stateCache = new BlockState[SLOTS];
+        this.canPlaceCache = new byte[SLOTS];
+        this.powerBlockPosCache = new byte[SLOTS];
+        this.strongPowerCache = new byte[SLOTS];
+        this.emittingCache = new short[SLOTS];
+    }
+
+    public @NotNull World world() {
+        return world;
+    }
+
+    public @NotNull BlockPos targetPos() {
+        return targetPos;
+    }
+
+    public boolean hasDependBlock() {
+        return hasDependBlock;
+    }
+
+    /** 把相对 targetPos 的三个分量打成一个数组下标；超出盒子返回 {@link #OUT_OF_BOX}。 */
+    private static int pack(int x, int y, int z) {
+        if (x < -RANGE_X || x > RANGE_X || y < -RANGE_Y || y > RANGE_Y || z < -RANGE_Z || z > RANGE_Z)
+            return OUT_OF_BOX;
+        return ((x + RANGE_X) * DIM_Y + (y + RANGE_Y)) * DIM_Z + (z + RANGE_Z);
+    }
+
+    /**
+     * 偏移 -> 盒子下标。{@link #OUT_OF_BOX} 表示落在盒子外（只能退回世界查询）。
+     *
+     * <p>暴露出来是为了<b>同一个位置只算一次下标</b>：{@code testBeforePlace} 一次候选里会对同一个位置
+     * 查 3~4 个缓存（位置表 / 方块状态 / 可放置 / 强充能），每次都重算的话，
+     * JFR 实测下标计算（{@code pack} + {@code slotOfPos}）占单次搜索约 19%。
+     */
+    public static int slotOfOffset(@NotNull BlockPos offsetPos) {
+        return pack(offsetPos.getX(), offsetPos.getY(), offsetPos.getZ());
+    }
+
+    private int slotOfPos(@NotNull BlockPos pos) {
+        return pack(pos.getX() - targetPos.getX(), pos.getY() - targetPos.getY(), pos.getZ() - targetPos.getZ());
+    }
+
+    /**
+     * targetPos + offset。也走同一张位置表，所以同一个位置只会算一次 BlockPos。
+     */
+    public @NotNull BlockPos posAt(@NotNull BlockPos offsetPos) {
+        return posAt(slotOfOffset(offsetPos), offsetPos);
+    }
+
+    /** 已经算过下标时用这个，省掉一次下标计算。 */
+    public @NotNull BlockPos posAt(int slot, @NotNull BlockPos offsetPos) {
+        return targetPos.add(offsetPos);
+    }
+
+    public @NotNull BlockState state(@NotNull BlockPos pos) {
+        return stateAt(slotOfPos(pos), pos);
+    }
+
+    /** 已经算过下标时用这个。 */
+    public @NotNull BlockState stateAt(int slot, @NotNull BlockPos pos) {
+        if (slot == OUT_OF_BOX)
+            return world.getBlockState(pos);
+        final int i = slot;
+        final BlockState cached = stateCache[i];
+        if (cached != null)
+            return cached;
+        final BlockState state = world.getBlockState(pos);
+        stateCache[i] = state;
+        return state;
+    }
+
+    /** {@code world.canPlace(STONE, pos, ShapeContext.absent())}，这个调用内部会做实体碰撞扫描。 */
+    public boolean canPlaceStone(@NotNull BlockPos pos) {
+        return canPlaceStoneAt(slotOfPos(pos), pos);
+    }
+
+    /** 已经算过下标时用这个。 */
+    public boolean canPlaceStoneAt(int slot, @NotNull BlockPos pos) {
+        if (slot == OUT_OF_BOX)
+            return world.canPlace(STONE, pos, ShapeContext.absent());
+        final int i = slot;
+        final byte cached = canPlaceCache[i];
+        if (cached != UNKNOWN)
+            return cached == YES;
+        final boolean result = world.canPlace(STONE, pos, ShapeContext.absent());
+        canPlaceCache[i] = result ? YES : NO;
+        return result;
+    }
+
+    public int strongRedstonePower(@NotNull BlockPos pos) {
+        return strongRedstonePowerAt(slotOfPos(pos), pos);
+    }
+
+    /** 已经算过下标时用这个。 */
+    public int strongRedstonePowerAt(int slot, @NotNull BlockPos pos) {
+        if (slot == OUT_OF_BOX)
+            return world.getReceivedStrongRedstonePower(pos);
+        final int i = slot;
+        final byte cached = strongPowerCache[i];
+        if (cached != 0)
+            return cached - 1;
+        final int result = world.getReceivedStrongRedstonePower(pos);
+        strongPowerCache[i] = (byte) (result + 1);
+        return result;
+    }
+
+    public boolean isEmittingRedstonePower(@NotNull BlockPos pos, @NotNull Direction direction) {
+        final int slot = slotOfPos(pos);
+        if (slot == OUT_OF_BOX)
+            return world.isEmittingRedstonePower(pos, direction);
+        final int i = slot;
+        final int bit = 1 << direction.ordinal();
+        final short cached = emittingCache[i];
+        if ((cached & bit) != 0)
+            return (cached & (bit << 6)) != 0;
+        final boolean result = world.isEmittingRedstonePower(pos, direction);
+        emittingCache[i] = (short) (cached | bit | (result ? bit << 6 : 0));
+        return result;
+    }
+
+    /**
+     * {@code world.isInBuildLimit(pos)}。本身是纯边界判断（很便宜），但它<b>每个候选都会被问一次</b>：
+     * {@link BlockBreakStructure#testBeforePlace} 对每个候选都要判一次依赖方块的位置，
+     * 而依赖方块只由 (powerBlockOffset, powerBlockFace) 决定 —— 与 {@link #strongRedstonePower} 同一个位置集合。
+     * 一次 {@code SearchMode.All} 搜索实测调用 1905 次、不同位置只有 87 个，所以照样值得缓存。
+     */
+    public boolean isInBuildLimit(@NotNull BlockPos pos) {
+        return isInBuildLimitAt(slotOfPos(pos), pos);
+    }
+
+    /** 已经算过下标时用这个（{@code slot} 可以是 {@link #OUT_OF_BOX}）。 */
+    public boolean isInBuildLimitAt(int slot, @NotNull BlockPos pos) {
+        if (boxInBuildLimit)
+            return true;
+        if (slot == OUT_OF_BOX)
+            return world.isInBuildLimit(pos);
+        final byte cached = inBuildLimitCache[slot];
+        if (cached != UNKNOWN)
+            return cached == YES;
+        final boolean result = world.isInBuildLimit(pos);
+        inBuildLimitCache[slot] = result ? YES : NO;
+        return result;
+    }
+
+    public boolean isReplaceable(@NotNull BlockPos pos) {
+        return BlockUtils.isReplaceable(state(pos));
+    }
+
+    /**
+     * 活塞摆放子检查（原 {@link BlockBreakStructure#testBeforePlace} 的前半段）：
+     * 活塞本体可放、活塞头位置可放、且不会因为红石干扰而提前伸出。
+     * 只由 (pistonOffset, pistonFace) 决定 —— 这正是 81 倍重复的来源。
+     */
+    public boolean pistonPlacementOk(@NotNull BlockBreakStructure structure) {
+        final int key = structure.pistonPlacementKey;
+        final byte cached = pistonPlacementCache[key];
+        if (cached != UNKNOWN)
+            return cached == YES;
+        final BlockPos pistonPos = posAt(structure.pistonOffsetPos);
+        pistonPosCache[key] = pistonPos;
+        boolean ok = isInBuildLimit(pistonPos)
+                && isReplaceable(pistonPos)
+                && canPlaceStone(pistonPos);
+        if (ok) {
+            final BlockPos pistonHeadPos = posAt(structure.pistonHeadOffsetPos);
+            pistonHeadPosCache[key] = pistonHeadPos;
+            ok = isInBuildLimit(pistonHeadPos)
+                    && isReplaceable(pistonHeadPos)
+                    && canPlaceStone(pistonHeadPos)
+                    && BlockFinder.isPistonPlaceSafe(this, pistonPos, structure.pistonFace);
+        }
+        pistonPlacementCache[key] = ok ? YES : NO;
+        return ok;
+    }
+
+    /**
+     * 把 pistonPlacementOk == false 的结构从 {@code bits} 里清掉。
+     * 只调 30 次活塞检查（每种 pistonOffset+pistonFace 组合一次），然后对 NO 的组合
+     * AND NOT {@code mPiston[key]}——原来这些是在 advance 里逐候选跑 testBeforePlace 时 return false 的。
+     */
+    public void applyPistonMask(@NotNull long[] bits, long[][] mPiston) {
+        final Direction[] directions = Direction.values();
+        for (int key = 0; key < mPiston.length; ++key) {
+            if (mPiston[key] == null)
+                continue;
+            final byte cached = pistonPlacementCache[key];
+            if (cached == UNKNOWN) {
+                final Direction pistonOffset = directions[key / directions.length];
+                final Direction pistonFace = directions[key % directions.length];
+                final BlockPos pistonOffsetPos = BlockPos.ORIGIN.offset(pistonOffset);
+                final BlockPos pistonHeadOffsetPos = pistonOffsetPos.offset(pistonFace);
+                final BlockPos pistonPos = posAt(pistonOffsetPos);
+                pistonPosCache[key] = pistonPos;
+                boolean ok = isInBuildLimit(pistonPos)
+                        && isReplaceable(pistonPos)
+                        && canPlaceStone(pistonPos);
+                if (ok) {
+                    final BlockPos pistonHeadPos = posAt(pistonHeadOffsetPos);
+                    pistonHeadPosCache[key] = pistonHeadPos;
+                    ok = isInBuildLimit(pistonHeadPos)
+                            && isReplaceable(pistonHeadPos)
+                            && canPlaceStone(pistonHeadPos)
+                            && BlockFinder.isPistonPlaceSafe(this, pistonPos, pistonFace);
+                }
+                pistonPlacementCache[key] = ok ? YES : NO;
+            }
+            if (pistonPlacementCache[key] == NO) {
+                BitSetUtils.orIfPresent(bits, mPiston[key]);
+            }
+        }
+    }
+
+    public @NotNull BlockPos pistonPos(@NotNull BlockBreakStructure structure) {
+        final BlockPos cached = pistonPosCache[structure.pistonPlacementKey];
+        if (cached != null)
+            return cached;
+        return posAt(structure.pistonOffsetPos);
+    }
+
+    public @NotNull BlockPos pistonHeadPos(@NotNull BlockBreakStructure structure) {
+        final BlockPos cached = pistonHeadPosCache[structure.pistonPlacementKey];
+        if (cached != null)
+            return cached;
+        return posAt(structure.pistonHeadOffsetPos);
+    }
+
+    /**
+     * 能源方块位置可放性，只由位置决定。
+     *
+     * <p>这里必须单独缓存：{@code isReplaceable} 走 {@link #state} 的表很便宜，
+     * 但 {@code world.isInBuildLimit(...)} 是一次跨对象调用 —— 不缓存的话它会被每个候选重复调用，
+     * 实测会把每轮搜索的 isInBuildLimit 次数从 1.3k 抬到 2.5k。
+     */
+    public boolean powerBlockPosOk(@NotNull BlockPos powerBlockPos) {
+        return powerBlockPosOkAt(slotOfPos(powerBlockPos), powerBlockPos);
+    }
+
+    /** 已经算过下标时用这个。 */
+    public boolean powerBlockPosOkAt(int slot, @NotNull BlockPos powerBlockPos) {
+        if (slot == OUT_OF_BOX)
+            return world.isInBuildLimit(powerBlockPos) && isReplaceable(powerBlockPos);
+        final int i = slot;
+        final byte cached = powerBlockPosCache[i];
+        if (cached != UNKNOWN)
+            return cached == YES;
+        final boolean ok = isInBuildLimit(powerBlockPos) && isReplaceable(powerBlockPos);
+        powerBlockPosCache[i] = ok ? YES : NO;
+        return ok;
+    }
+}
